#!/bin/bash

# Find project directory
PROJECT_DIR="/Users/aminemerdassi/Desktop/Gym/albion online project"
if [ ! -d "$PROJECT_DIR" ]; then
    PROJECT_DIR="/Users/aminemerdassi/Desktop/albion online project"
fi
if [ ! -d "$PROJECT_DIR" ]; then
    PROJECT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
fi

# If server is already running, just open browser
if lsof -i :8765 >/dev/null 2>&1; then
    open "http://localhost:8765"
    exit 0
fi

# Launch in Terminal (ensures proper macOS permissions and shows live scan logs)
osascript << APPLESCRIPT
tell application "Terminal"
    activate
    do script "cd \"$PROJECT_DIR\" && [ ! -d \".venv\" ] && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt; clear; echo '⚔️  Albion Market Pulse is running!'; echo '👉 Web Dashboard: http://localhost:8765'; echo '------------------------------------------------'; .venv/bin/python -m albion_flips.cli --watch --web"
end tell
APPLESCRIPT

# Wait for server to bind then open browser
for i in {1..20}; do
    if lsof -i :8765 >/dev/null 2>&1; then
        break
    fi
    sleep 0.5
done

open "http://localhost:8765"
