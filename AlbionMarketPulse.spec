# PyInstaller spec for the standalone Windows app. Build with build_exe.bat.
# -*- mode: python ; coding: utf-8 -*-
from PyInstaller.utils.hooks import collect_submodules

datas = [
    ("data/items.json", "data"),
    ("data/items.txt", "data"),        # AlbionId -> item id for live sales history
    ("data/item_names.json", "data"),
    ("data/recipes.json", "data"),     # generated by tools/build_recipes.py
    ("assets/icon.ico", "assets"),
    ("assets/icon.png", "assets"),
    ("assets/logo.svg", "assets"),
    ("config.example.json", "."),
]

a = Analysis(
    ["run_desktop.py"],
    pathex=[],
    binaries=[],
    datas=datas,
    hiddenimports=collect_submodules("webview.platforms") + ["clr"],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=["tkinter", "pytest", "_pytest", "PyInstaller"],
    noarchive=False,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="AlbionMarketPulse",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    runtime_tmpdir=None,
    console=False,
    disable_windowed_traceback=False,
    icon="assets/icon.ico",
)
